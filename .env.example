# Django Environment Configuration
# Copy this file to .env and configure your values as needed.

# Django Security
SECRET_KEY=your-secret-key-here-must-be-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# External Routing Service (OSRM public server - free, no API key required)
ROUTING_SERVICE_URL=http://router.project-osrm.org

# External Geocoding Service (Photon OSM-based geocoder - free, no API key required)
GEOCODING_SERVICE_URL=https://photon.komoot.io/api

# Vehicle Parameters
VEHICLE_MAX_RANGE_MILES=500.0
VEHICLE_FUEL_ECONOMY_MPG=10.0

# Station corridor search radius (miles away from highway)
FUEL_STATION_SEARCH_RADIUS_MILES=10.0
